@startuml VoltStream_Detailed_UML
title VoltStream — Detailed Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

package "grid.core" {
  class EVNetworkController {
    - stationBays: List<ChargingBay>
    - listeners: List<ChargingEventListener>
    - maxGridCapacityKw: double
    - totalRevenueGenerated: double = 0.0
    + EVNetworkController(maxGridCapacityKw: double) <<throws InvalidGridConfigurationException>>
    + addBay(bay: ChargingBay): void
    + addListener(listener: ChargingEventListener): void
    + getBays(): List<ChargingBay>
    + getMaxGridCapacityKw(): double
    + getTotalRevenue(): double
    + dispatchVehicle(ev: ElectricVehicle): void <<throws NoAvailableBayException, BayDockingException>>
    + getGridLoadFactor(): double
    + optimizeGridPower(): void
    + executeTimeStep(hours: double): void <<throws InvalidGridConfigurationException>>
    - notifyDocked(bay: ChargingBay, ev: ElectricVehicle): void
    - notifyChargingComplete(bay: ChargingBay, ev: ElectricVehicle): void
    - notifyStepStart(gridLoadFactor: double): void
    - notifyBayCharging(bay: ChargingBay, ev: ElectricVehicle, power: double, tariff: double): void
    - notifyBayIdle(bay: ChargingBay): void
    - notifyStepEnd(totalRevenue: double): void
  }
}

package "grid.charging" {
  interface ChargingInterface {
    + getMaximumHardwareOutput(): double
    + dock(ev: ElectricVehicle): void <<throws BayDockingException>>
    + undock(): void
  }

  abstract class ChargingBay {
    {static} + PEAK_LOAD_THRESHOLD: double = 0.75
    {static} - BASE_RATE_PER_KWH: double = 8.50
    - bayId: String
    - dockedVehicle: ElectricVehicle
    - currentAllocatedPower: double
    - tariffStrategy: TariffStrategy
    + ChargingBay(bayId: String, tariffStrategy: TariffStrategy)
    + getBayId(): String
    + getDockedVehicle(): ElectricVehicle
    + isOccupied(): boolean
    + getCurrentAllocatedPower(): double
    + setAllocatedPower(power: double): void
    + getRequestedPower(): double
    + getBillableRate(gridLoadFactor: double): double
    + dock(ev: ElectricVehicle): void <<throws BayDockingException>>
    + undock(): void
    {abstract} + getMaximumHardwareOutput(): double
    {abstract} + getBayType(): BayType
  }

  class UltraFastBay {
    + UltraFastBay(bayId: String)
    + getMaximumHardwareOutput(): double
    + getBayType(): BayType
  }

  class FastDCBay {
    + FastDCBay(bayId: String)
    + getMaximumHardwareOutput(): double
    + getBayType(): BayType
  }

  enum BayType {
    ULTRA_FAST
    FAST_DC
    - displayName: String
    + getDisplayName(): String
  }

  class ChargingBayFactory <<factory>> {
    {static} + createBay(type: BayType, bayId: String): ChargingBay
  }
}

package "grid.vehicles" {
  class ElectricVehicle {
    - type: VehicleType
    - plateNumber: String
    - batteryCapacity: double
    - maxChargingRate: double
    - currentCharge: double
    + ElectricVehicle(type: VehicleType, plateNumber: String, initialChargePercentage: double)
    + getType(): VehicleType
    + getPlateNumber(): String
    + getBatteryCapacity(): double
    + getCurrentCharge(): double
    + getMaxChargingRate(): double
    + getChargePercentage(): double
    + energyDelivered(kwh: double): void
    + isFullyCharged(): boolean
  }

  class VehicleFactory <<factory>> {
    {static} + createVehicle(type: VehicleType, plateNumber: String, initialChargePercentage: double): ElectricVehicle <<throws InvalidVehicleConfigurationException>>
  }
  enum VehicleType {
    SEDAN
    HEAVY_TRUCK
    SCOOTER
    BUS
    - displayName: String
    - batteryCapacity: double
    - maxChargingRate: double
    + getDisplayName(): String
    + getBatteryCapacity(): double
    + getMaxChargingRate(): double
  }
}

package "grid.tariff" {
  interface TariffStrategy {
    + getMultiplier(gridLoadFactor: double): double
  }
  class FlatTariffStrategy {
    - multiplier: double
    + FlatTariffStrategy(multiplier: double)
    + getMultiplier(gridLoadFactor: double): double
  }
  class PeakSurchargeTariffStrategy {
    - baseMultiplier: double
    - peakSurcharge: double
    - loadThreshold: double
    + PeakSurchargeTariffStrategy(baseMultiplier: double, peakSurcharge: double, loadThreshold: double)
    + getMultiplier(gridLoadFactor: double): double
  }
}

package "grid.exceptions" {
  class InvalidVehicleConfigurationException <<checked>> {
    + InvalidVehicleConfigurationException(message: String)
  }
  class NoAvailableBayException <<checked>> {
    + NoAvailableBayException()
  }
  class BayDockingException <<checked>> {
    + BayDockingException(message: String)
  }
  class InvalidGridConfigurationException <<unchecked>> {
    + InvalidGridConfigurationException(message: String)
  }
}

package "grid.events" {
  interface ChargingEventListener {
    + onVehicleDocked(bay: ChargingBay, ev: ElectricVehicle): void
    + onChargingComplete(bay: ChargingBay, ev: ElectricVehicle): void
    + onStepStart(gridLoadFactor: double): void
    + onBayCharging(bay: ChargingBay, ev: ElectricVehicle, power: double, tariff: double): void
    + onBayIdle(bay: ChargingBay): void
    + onStepEnd(totalRevenue: double): void
  }
  class EventLogListener {
    {static} - MAX_ENTRIES: int = 200
    - entries: Deque<Entry>
    - stepCount: int = 0
    + getStepCount(): int
    + getEntries(): List<Entry>
    + onVehicleDocked(bay: ChargingBay, ev: ElectricVehicle): void
    + onChargingComplete(bay: ChargingBay, ev: ElectricVehicle): void
    + onStepStart(gridLoadFactor: double): void
    + onBayCharging(bay: ChargingBay, ev: ElectricVehicle, power: double, tariff: double): void
    + onBayIdle(bay: ChargingBay): void
    + onStepEnd(totalRevenue: double): void
  }
}

package "grid.web" {
  class WebServer {
    - server: HttpServer
    - simulation: SimulationService
    - webRoot: Path
    + WebServer(port: int, webRoot: Path, simulation: SimulationService)
    + start(): void
    + getPort(): int
    - handleApi(exchange: HttpExchange): void
    - handleStatic(exchange: HttpExchange): void
  }

  class SimulationService {
    {static} - GRID_CAPACITY: double = 400.0
    {static} - TIME_STEP: double = 0.2
    - controller: EVNetworkController
    - eventLog: EventLogListener
    + reset(): void
    + addVehicle(type: String, plate: String, charge: String): void <<throws InvalidVehicleConfigurationException, NoAvailableBayException, BayDockingException>>
    + step(): void
    + snapshot(): Map<String, Object>
  }

  class Json <<utility>> {
    {static} ~ write(value: Object): String
  }
}

package "grid" {
  class Main <<application>> {
    {static} - DEFAULT_PORT: int = 8080
    {static} - WEB_ROOT: Path
    {static} + main(args: String[]): void
  }
}

Exception <|-- InvalidVehicleConfigurationException
Exception <|-- NoAvailableBayException
Exception <|-- BayDockingException
RuntimeException <|-- InvalidGridConfigurationException

ChargingInterface <|.. ChargingBay
ChargingBay <|-- UltraFastBay
ChargingBay <|-- FastDCBay
TariffStrategy <|.. FlatTariffStrategy
TariffStrategy <|.. PeakSurchargeTariffStrategy
ChargingEventListener <|.. EventLogListener

EVNetworkController *-- "0..*" ChargingBay : stationBays
EVNetworkController *-- "0..*" ChargingEventListener : listeners
ChargingBay *-- "1" TariffStrategy : tariffStrategy
ChargingBay --> "0..1" ElectricVehicle : dockedVehicle
VehicleFactory ..> VehicleType : <<use>>
ChargingBayFactory ..> BayType : <<use>>
ElectricVehicle --> "1" VehicleType : type
SimulationService ..> VehicleType : <<use>>
SimulationService ..> BayType : <<use>>

ChargingBayFactory ..> UltraFastBay : <<create>>
ChargingBayFactory ..> FastDCBay : <<create>>
UltraFastBay ..> PeakSurchargeTariffStrategy : <<create>>
FastDCBay ..> PeakSurchargeTariffStrategy : <<create>>
VehicleFactory ..> ElectricVehicle : <<create>>
EventLogListener ..> ChargingBay
EventLogListener ..> ElectricVehicle
VehicleFactory ..> InvalidVehicleConfigurationException : <<throws>>
EVNetworkController ..> NoAvailableBayException : <<throws>>
EVNetworkController ..> BayDockingException : <<throws>>
EVNetworkController ..> InvalidGridConfigurationException : <<throws>>
ChargingBay ..> BayDockingException : <<throws>>
WebServer ..> InvalidVehicleConfigurationException : <<catch>>
WebServer ..> NoAvailableBayException : <<catch>>
WebServer ..> BayDockingException : <<catch>>
WebServer --> "1" SimulationService : simulation
WebServer ..> Json : <<use>>
SimulationService *-- "1" EVNetworkController : controller
SimulationService *-- "1" EventLogListener : eventLog
SimulationService ..> ChargingBayFactory : <<use>>
SimulationService ..> VehicleFactory : <<use>>
Main ..> WebServer : <<create>>
Main ..> SimulationService : <<create>>
@enduml
